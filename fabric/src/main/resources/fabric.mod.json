{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "Preserved: Inferno",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/preserved-inferno",
        "sources": "https://github.com/Sir-Cow/preserved-inferno",
        "issues": "https://github.com/Sir-Cow/preserved-inferno/issues"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "sircow.preservedinferno.PreservedInferno"
        ],
        "client": [
            "sircow.preservedinferno.client.FabricPreservedInfernoClient"
        ],
        "fabric-datagen": [
            "sircow.preservedinferno.datagen.ModDataGenerator"
        ],
        "jade": [
            "sircow.preservedinferno.compat.jade.JadePlugin"
        ],
        "jei_mod_plugin": [
            "sircow.preservedinferno.compat.jei.PreservedJeiPlugin"
        ],
        "modmenu": [
            "sircow.preservedinferno.config.ModMenuCompat"
        ]
    },
    "mixins": [
        "pinferno.mixins.json",
        "pinferno.fabric.mixins.json",
        "pinferno.betteradvancements.mixins.json",
        "pinferno.jade.mixins.json",
        "pinferno.lootr.mixins.json"
    ],
    "accessWidener": "pinferno.classtweaker",
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}",
        "fabric-language-kotlin": ">=1.13.13"
    },
    "breaks": {
        "reverbcompass": "*",
        "torrential": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.modrinth": "https://modrinth.com/mod/preserved-inferno",
                "modmenu.curseforge": "https://curseforge.com/minecraft/mc-mods/preserved-inferno"
            },
            "update_checker": true
        }
    }
}
  